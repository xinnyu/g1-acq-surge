#!name=G1 ACQ
#!desc=Surge 移植自 crhywun/g1-acq v7.5.0：被动采集 one.google.com 原始 SKU，仅对 /ai? 做三档改写；本机报告 /g1-sku-report

# 不拦全局 UDP 443。Surge 对 MITM hostname 默认 auto-quic-block，只让 one.google.com 的 QUIC 回退到 TCP。
# max-size=-1：上游写成 0。Surge 里这是字节数，0 会把正文整段跳过。

[Script]
g1-acq = type=http-response,pattern=^https://one\.google\.com/,requires-body=true,max-size=-1,binary-body-mode=false,script-path=https://cdn.jsdelivr.net/gh/xinnyu/g1-acq-surge@main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https://one\.google\.com/g1-sku-report/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/xinnyu/g1-acq-surge@main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
