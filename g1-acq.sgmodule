#!name=G1 ACQ
#!desc=Surge 移植（土耳其区低价版）：Ultra 20TB → g1.ios.20tb.m（₺1,989.99/月）、Ultra 30TB → g1.ios.30tb.m（₺2,949.99/月）；Pro 5TB 仍走 g1.2tb.ai.18months_eft（18 个月免费）。需土区 Apple ID 与土区付款方式

# 不拦全局 UDP 443。Surge 对 MITM hostname 默认 auto-quic-block，只让 one.google.com 的 QUIC 回退到 TCP。
# max-size=-1：上游写成 0。Surge 里是字节数，0 会把正文整段跳过。

[Script]
g1-acq = type=http-response,pattern=^https://one\.google\.com/,requires-body=true,max-size=-1,binary-body-mode=false,script-path=https://cdn.jsdelivr.net/gh/xinnyu/g1-acq-surge@v8.0.2/g1-acq.js
g1-sku-report = type=http-request,pattern=^https://one\.google\.com/g1-sku-report/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/xinnyu/g1-acq-surge@v8.0.2/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
