#!name=G1 ACQ
#!desc=Surge 移植 tgai521/g1-acq-plus v8.0.0：Pro 5TB 18/15/12 个月 $0 免费试用（默认 g1.2tb.ai.18months_eft）、Ultra 20TB/30TB 1 个月免费试用并自动回退 3 个月 1 折；本机 Safari 控制台可一键切换目标 SKU

# 不拦全局 UDP 443。Surge 对 MITM hostname 默认 auto-quic-block，只让 one.google.com 的 QUIC 回退到 TCP。
# max-size=-1：上游写成 0。Surge 里是字节数，0 会把正文整段跳过。

[Script]
g1-acq = type=http-response,pattern=^https://one\.google\.com/,requires-body=true,max-size=-1,binary-body-mode=false,script-path=https://cdn.jsdelivr.net/gh/xinnyu/g1-acq-surge@v8.0.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https://one\.google\.com/g1-sku-report/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/xinnyu/g1-acq-surge@v8.0.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
